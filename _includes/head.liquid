<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

{% comment %}
  Social previews need alt text; metadata.liquid only emits the images. A page
  may supply its own alt even when the site has no default, so both are
  resolved independently and the tags are emitted only when an image exists.
{% endcomment %}
{% if site.serve_og_meta %}
  {% assign og_image_path = page.og_image | default: site.og_image %}
  {% assign og_image_alt = page.og_image_alt | default: site.og_image_alt %}
  {% if og_image_path and og_image_alt %}
    <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
    <meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">
  {% endif %}
{% endif %}

{% comment %}
  Schema.org Person: identity signals (name, role, affiliation, profile links)
  for the researcher behind the site. Search engines use these to connect the
  domain with the person; sameAs is built from _data/socials.yml so the links
  cannot drift from the ones in the footer.
{% endcomment %}
{% if site.person_schema.enabled %}
  {% assign same_as = '' | split: '' %}
  {% assign socials = site.data.socials %}
  {% if socials.orcid_id %}
    {% capture orcid_url %}https://orcid.org/{{ socials.orcid_id }}{% endcapture %}
    {% assign same_as = same_as | push: orcid_url %}
  {% endif %}
  {% if socials.scholar_userid %}
    {% capture scholar_url %}https://scholar.google.com/citations?user={{ socials.scholar_userid }}{% endcapture %}
    {% assign same_as = same_as | push: scholar_url %}
  {% endif %}
  {% if socials.inspirehep_id %}
    {% capture inspirehep_url %}https://inspirehep.net/authors/{{ socials.inspirehep_id }}{% endcapture %}
    {% assign same_as = same_as | push: inspirehep_url %}
  {% endif %}
  {% if socials.github_username %}
    {% capture github_url %}https://github.com/{{ socials.github_username }}{% endcapture %}
    {% assign same_as = same_as | push: github_url %}
  {% endif %}
  {% capture person_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": {{ person_name | jsonify }},
      "url": {{ '/' | absolute_url | jsonify }},
      "jobTitle": {{ site.person_schema.job_title | jsonify }},
      "description": {{ site.description | jsonify }},
      "affiliation": {
        "@type": "Organization",
        "name": {{ site.person_schema.affiliation | jsonify }},
        "url": {{ site.person_schema.affiliation_url | jsonify }}
      },
      "sameAs": {{ same_as | jsonify }}
    }
  </script>
{% endif %}

<!-- Bootstrap & MDB -->
<link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
<link
  rel="stylesheet"
  href="{{ site.third_party_libraries.mdb.url.css }}"
  integrity="{{ site.third_party_libraries.mdb.integrity.css }}"
  crossorigin="anonymous"
>

{% if page.pretty_table %}
  <!-- Bootstrap Table -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Fonts & Icons -->
<link defer rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}">
<link defer rel="stylesheet" href="{{ '/assets/css/scholar-icons.css' | relative_url | bust_file_cache }}">
<!-- Text fonts (Inter, DM Serif Display, JetBrains Mono) are self-hosted in
     /assets/fonts and declared in _sass/_fonts.scss — no Google Fonts request. -->

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light"
>

{% if page.toc and page.toc.sidebar %}
  <!-- Sidebar Table of Contents -->
  <link defer href="{{ '/assets/css/bootstrap-toc.min.css' | relative_url | bust_file_cache }}" rel="stylesheet">
{% endif %}

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% comment %}
  One canonical per page, absolute, without the index.html suffix. The 404 page
  is a redirect target: it gets no canonical and must not be indexed.
{% endcomment %}
{% if page.url == '/404.html' %}
  <meta name="robots" content="noindex, follow">
{% else %}
  <link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
{% endif %}

{% if site.enable_darkmode %}
  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >
  <script>
    initTheme();
  </script>
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.images %}
  {% if page.images.compare %}
    <!-- Image comparison slider -->
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.img-comparison-slider.url.css }}"
      integrity="{{ site.third_party_libraries.img-comparison-slider.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
  {% if page.images.lightbox2 %}
    <!-- Lightbox2 -->
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.lightbox2.url.css }}"
      integrity="{{ site.third_party_libraries.lightbox2.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
  {% if page.images.photoswipe %}
    <!-- Photoswipe -->
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.photoswipe.url.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
  {% if page.images.slider %}
    <!-- Image slider -->
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.swiper.url.css }}"
      integrity="{{ site.third_party_libraries.swiper.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
  {% if page.images.spotlight %}
    <!-- Spotlight -->
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.spotlight.url.css }}"
      integrity="{{ site.third_party_libraries.spotlight.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
  {% if page.images.venobox %}
    <!-- Venobox -->
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.venobox.url.css }}"
      integrity="{{ site.third_party_libraries.venobox.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
{% endif %}

{% if page.tikzjax %}
  <link defer rel="stylesheet" type="text/css" href="https://tikzjax.com/v1/fonts.css">
{% endif %}
